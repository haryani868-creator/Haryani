# Salin fail ini kepada .env dan isi kunci yang anda ada.
# Platform tanpa kunci akan dilangkau secara automatik.

# Kata kunci / hashtag yang dipantau (dipisah koma)
# Niche kurus & cantik (kosongkan untuk guna senarai lalai dalam viral_watch/niche.py)
VW_KEYWORDS=kurus,kuruscantik,programkurus,produkkurus,turunberat,dietsihat,langsing,slimming,weightloss,kempiskanperut

# Ambang: pos dianggap viral jika kelajuan >= N kali median platform
VW_VIRAL_MULTIPLIER=5
VW_MIN_ENGAGEMENT=500

# Lokasi pangkalan data SQLite
VW_DB_PATH=data/viral_watch.db

# Aktifkan data demo (sintetik) untuk cuba papan pemuka tanpa kunci API
VW_DEMO=1

# --- X (Twitter) API v2: perlu pelan Basic atau lebih tinggi ---
X_BEARER_TOKEN=

# --- TikTok Research API: perlu kelulusan TikTok for Developers ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REGION=MY

# --- Instagram Graph API: perlu akaun Business/Creator dipaut ke Page Facebook ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Facebook Graph API: ID Page (dipisah koma) + token ---
FB_PAGE_IDS=
FB_ACCESS_TOKEN=

GRAPH_API_VERSION=v21.0
